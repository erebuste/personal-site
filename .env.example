# Copy to .env and fill in. Passed to the api container only (env_file in docker-compose.yml).

# Password for /admin. Use something long.
ADMIN_PASSWORD=

# Required: signs login sessions, at least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# User and group the api runs as and ./data is owned by (default 1000). Set them to the output of
# `id -u` and `id -g` so you can edit and back up ./data without sudo.
UID=1000
GID=1000

# Set to true once the site is served over HTTPS: marks the login cookie Secure and turns on HSTS
# (browsers then refuse plain http for a year, so only flip it once HTTPS works).
COOKIE_SECURE=false

# Your own Discord bot for the presence card. discord.com/developers/applications → New Application →
# Bot: Reset Token (paste below) and turn on "Presence Intent" → OAuth2 → URL Generator: scope "bot",
# no permissions → open the URL and add the bot to a server you're in. Leave empty to disable.
DISCORD_BOT_TOKEN=
