# Copy to .env and fill in. docker compose reads it automatically.

# Password for /admin. Use something long.
ADMIN_PASSWORD=

# Keeps you logged in across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# Your own Discord bot for the presence card. discord.com/developers/applications → New Application →
# Bot: Reset Token (paste below) and turn on "Presence Intent" → OAuth2 → URL Generator: scope "bot",
# no permissions → open the URL and add the bot to a server you're in. Leave empty to disable.
DISCORD_BOT_TOKEN=
